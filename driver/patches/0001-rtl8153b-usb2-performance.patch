+/* RTL8153B MAC clock speed-down per the mac_clk_spdwn parameter. Modes 0
+ * and 1 touch only MAC_CLK_SPDWN_EN and PLA_MCU_SPDWN_EN, as upstream and
+ * Realtek do; values an earlier driver wrote to PLA_MAC_PWR_CTRL/CTRL4
+ * stay until the adapter loses power.
+ */
+static void r8153b_mac_clk_cfg(struct r8152 *tp)
+{
+	u32 ocp_data;
+
+	if (mac_clk_spdwn == 2) {
+		r8153_mac_clk_table(tp);
+		return;
+	}
+
+	ocp_data = ocp_read_word(tp, MCU_TYPE_PLA, PLA_MAC_PWR_CTRL2);
+	if (mac_clk_spdwn)
+		ocp_data |= MAC_CLK_SPDWN_EN;
+	else
+		ocp_data &= ~MAC_CLK_SPDWN_EN;
+	ocp_write_word(tp, MCU_TYPE_PLA, PLA_MAC_PWR_CTRL2, ocp_data);
+
+	r8153b_mcu_spdwn_en(tp, false);
+}
