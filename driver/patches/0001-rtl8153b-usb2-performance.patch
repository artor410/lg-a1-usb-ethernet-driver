+/* RTL8153B PHY parameters (phy_8153b), from upstream r8153b_hw_phy_cfg()
+ * (v6.6) without the firmware, the UPS timing and Advanced EEE. Called with
+ * ALDPS off, like r8153_hw_phy_cfg(). The RTL8153A SRAM impedance, LPF and
+ * 10M amplitude words are not written.
+ */
+static void r8153b_hw_phy_cfg(struct r8152 *tp)
+{
+	u32 ocp_data;
+	u16 data;
+
+	ocp_data = ocp_read_word(tp, MCU_TYPE_USB, USB_MISC_0);
+	if (ocp_data & PCUT_STATUS) {
+		ocp_data &= ~PCUT_STATUS;
+		ocp_write_word(tp, MCU_TYPE_USB, USB_MISC_0, ocp_data);
+	}
+
+	/* disable EEE before updating the PHY parameters */
+	r8153_eee_en(tp, false);
+	ocp_reg_write(tp, OCP_EEE_ADV, 0);
+
+	data = r8152_mdio_read(tp, MII_BMCR);
+	if (data & BMCR_PDOWN) {
+		data &= ~BMCR_PDOWN;
+		r8152_mdio_write(tp, MII_BMCR, data);
+	}
+
+	/* green ethernet (r8153b_green_en(tp, true)) */
+	sram_write(tp, 0x8045, 0);	/* 10M abiq&ldvbias */
+	sram_write(tp, 0x804d, 0x1222);	/* 100M short abiq&ldvbias */
+	sram_write(tp, 0x805d, 0x0022);	/* 1000M short abiq&ldvbias */
+	data = sram_read(tp, SRAM_GREEN_CFG);
+	data |= GREEN_ETH_EN | R_TUNE_EN;
+	sram_write(tp, SRAM_GREEN_CFG, data);
+
+	data = ocp_reg_read(tp, OCP_NCTL_CFG);
+	data |= PGA_RETURN_EN;
+	ocp_reg_write(tp, OCP_NCTL_CFG, data);
+
+	/* ADC Bias Calibration:
+	 * read efuse offset 0x7d to get a 17-bit data. Remove the dummy/fake
+	 * bit (bit3) to rebuild the real 16-bit data. Write the data to the
+	 * ADC ioffset.
+	 */
+	ocp_data = r8152_efuse_read(tp, 0x7d);
+	data = (u16)(((ocp_data & 0x1fff0) >> 1) | (ocp_data & 0x7));
+	if (data != 0xffff)
+		ocp_reg_write(tp, OCP_ADC_IOFFSET, data);
+
+	ocp_data = ocp_read_word(tp, MCU_TYPE_PLA, PLA_PHY_PWR);
+	ocp_data |= PFM_PWM_SWITCH;
+	ocp_write_word(tp, MCU_TYPE_PLA, PLA_PHY_PWR, ocp_data);
+
+	r8153_enable_eee(tp);
+
+	set_bit(PHY_RESET, &tp->flags);
+}
