+static void rtl_link_report(struct r8152 *tp, u8 speed)
+{
+	u16 lcl = r8152_mdio_read(tp, MII_ADVERTISE);
+	u16 rmt = r8152_mdio_read(tp, MII_LPA);
+	u8 pause = (speed & FULL_DUP) ? mii_resolve_flowctrl_fdx(lcl, rmt) : 0;
+	u16 eee_adv = 0, eee_lp = 0, eee_mac = 0;
+
+	if (tp->mii.supports_gmii) {
+		eee_adv = ocp_reg_read(tp, OCP_EEE_ADV);
+		eee_lp = ocp_reg_read(tp, OCP_EEE_LPABLE);
+		eee_mac = ocp_read_word(tp, MCU_TYPE_PLA, PLA_EEE_CR) &
+			  (EEE_RX_EN | EEE_TX_EN);
+	}
+
+	netif_info(tp, link, tp->netdev,
+		   "ver %d phystatus 0x%02x %s/%s, pause adv %x lp %x -> tx %d rx %d, eee adv 0x%x lp 0x%x mac 0x%x\n",
+		   tp->version, speed,
+		   (speed & _1000bps) ? "1000" : (speed & _100bps) ? "100" : "10",
+		   (speed & FULL_DUP) ? "full" : "half",
+		   (lcl >> 10) & 3, (rmt >> 10) & 3,
+		   !!(pause & FLOW_CTRL_TX), !!(pause & FLOW_CTRL_RX),
+		   eee_adv, eee_lp, eee_mac);
+}
